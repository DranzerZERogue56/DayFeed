# Copy this file to android/keystore.properties (gitignored) after running
# `expo prebuild`. Release builds are debug-signed until this file exists —
# see CLAUDE.md "Build notes" for how to generate the keystore itself.
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=changeme
RELEASE_KEY_ALIAS=dayfeed-release
RELEASE_KEY_PASSWORD=changeme
